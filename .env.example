# ============================================================
# 环境变量示例 —— 复制本文件为 .env 后填写
# 注意：.env 已被 .gitignore 忽略，永远不会提交到仓库
# ============================================================

# ---------- 自带 OCR（必填，见 server/ocr-provider.js）----------
# 任何兼容 OpenAI Chat Completions 的图片理解服务都可以，例如：
#   硅基流动  https://api.siliconflow.cn/v1
#   OpenAI    https://api.openai.com/v1
#   通义/其他 以服务商文档为准
#   本地服务   http://127.0.0.1:11434/v1  (Ollama 等)
OCR_BASE_URL=https://你的服务地址/v1
OCR_API_KEY=你的API密钥
OCR_VISION_MODEL=你的图片理解模型名
# 可选：纯文本模型（不填则复用视觉模型）
OCR_TEXT_MODEL=
# 可选：超时毫秒，默认 90000
OCR_TIMEOUT_MS=90000

# ---------- 服务监听（可选）----------
LOCAL_PORT=3000
SERVER_HOST=127.0.0.1
