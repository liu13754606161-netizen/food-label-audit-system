{
  "id": "ai_food_info_extraction_from_doc_1",
  "pluginKey": "@official-plugins/ai-text-to-json",
  "pluginVersion": "1.0.18",
  "name": "文档食品信息结构化提取",
  "description": "从PDF/Word等文档中提取食品相关的结构化信息，包括食品名称、配料表、营养成分等12个字段。",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "doc_text": {
        "type": "string",
        "description": "解析后的文档文本内容"
      }
    },
    "required": [
      "doc_text"
    ]
  },
  "formValue": {
    "jsonStructure": [
      {
        "paramType": "String",
        "paramDescription": "食品名称",
        "name": "food_name"
      },
      {
        "name": "product_type",
        "paramType": "String",
        "paramDescription": "产品类型"
      },
      {
        "name": "ingredients_list",
        "paramType": "String",
        "paramDescription": "配料表"
      },
      {
        "name": "nutrition_facts",
        "paramType": "String",
        "paramDescription": "营养成分"
      },
      {
        "name": "net_content",
        "paramType": "String",
        "paramDescription": "净含量"
      },
      {
        "name": "production_date",
        "paramType": "String",
        "paramDescription": "生产日期"
      },
      {
        "paramDescription": "保质期",
        "name": "shelf_life",
        "paramType": "String"
      },
      {
        "name": "storage_condition",
        "paramType": "String",
        "paramDescription": "贮存条件"
      },
      {
        "name": "production_license",
        "paramType": "String",
        "paramDescription": "生产许可证"
      },
      {
        "name": "product_standard_number",
        "paramType": "String",
        "paramDescription": "产品标准号"
      },
      {
        "name": "allergen",
        "paramType": "String",
        "paramDescription": "过敏源"
      },
      {
        "paramType": "String",
        "paramDescription": "温馨提示",
        "name": "warm_prompt"
      }
    ],
    "modelID": "87",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    },
    "prompt": "你是一位专业的食品信息提取专家，请从以下文档文本中准确提取食品相关的信息。如果某个字段在文档中不存在，请填为空字符串。\n\n文档文本：{{input.doc_text}}\n\n提取要求：所有字段严格按照文档内容提取，不得编造信息，确保提取结果的准确性。"
  },
